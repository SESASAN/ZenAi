# Backend (Vercel /api/*) — providers
GROQ_API_KEY=
CEREBRAS_API_KEY=

# Backend (Vercel /api/*) — firebase-admin
# Puede ser JSON completo o base64 del JSON del service account.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Backend (opcional) — orígenes extra permitidos por CORS, separados por coma.
# https://sesasan.github.io y localhost ya están permitidos.
ALLOWED_ORIGINS=

# Backend (opcional) — límite de mensajes por usuario (por defecto 10/min y 200/día).
CHAT_RATE_LIMIT_PER_MINUTE=
CHAT_RATE_LIMIT_PER_DAY=

# Frontend (Vite) — apunta al backend (opcional)
VITE_CHAT_API_URL=http://127.0.0.1:3001

# Frontend (Vite) — Firebase Web config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
